{
  "name": "berry-vuetify-vuejs",
  "version": "1.6.0",
  "private": true,
  "author": "CodedThemes",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build-stage": "vue-tsc --noEmit && vite build --base=/vue/stage/",
    "build-prod": "vue-tsc --noEmit && vite build --base=/vue/",
    "preview": "vite preview --port 5050",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-pattern .gitignore"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@tsconfig/node22": "22.0.2",
    "@typescript-eslint/parser": "8.39.0",
    "axios": "1.11.0",
    "axios-mock-adapter": "2.1.0",
    "chance": "1.1.13",
    "date-fns": "4.1.0",
    "lodash": "4.17.21",
    "pinia": "3.0.3",
    "vee-validate": "4.15.1",
    "vite-plugin-vuetify": "2.1.2",
    "vue": "3.5.18",
    "vue-clipboard3": "2.0.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-i18n": "11.1.11",
    "vue-router": "4.5.1",
    "vue-tabler-icons": "2.21.0",
    "vue3-perfect-scrollbar": "2.0.0",
    "vuedraggable": "2.24.3",
    "vuetify": "3.9.3",
    "webpack-plugin-vuetify": "3.1.2",
    "yup": "1.7.0"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/chance": "1.1.7",
    "@types/node": "24.2.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/eslint-config-prettier": "9.0.0",
    "@vue/tsconfig": "0.7.0",
    "eslint": "9.32.0",
    "eslint-plugin-vue": "10.4.0",
    "prettier": "3.6.2",
    "sass": "1.90.0",
    "sass-loader": "16.0.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.0",
    "vite": "7.0.6",
    "vue-cli-plugin-vuetify": "2.5.8",
    "vue-tsc": "3.0.5"
  }
}
